{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Avaliar AI",
  "colors": {
    "primary": "#af35ef",
    "light": "#dc8af0",
    "dark": "#83029b"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart",
              "concepts"
            ]
          },
          {
            "group": "Python SDK",
            "pages": [
              "sdk/installation",
              "sdk/quickstart",
              "sdk/guard",
              "sdk/policy",
              "sdk/detection",
              "sdk/examples",
              "sdk/deep-check",
              "sdk/evidence",
              "sdk/error-handling"
            ]
          },
          {
            "group": "SDK checkpoints",
            "pages": [
              "sdk/checkpoints/input",
              "sdk/checkpoints/output",
              "sdk/checkpoints/tool-call",
              "sdk/checkpoints/tool-result",
              "sdk/checkpoints/action"
            ]
          },
          {
            "group": "SDK integrations and cloud",
            "pages": [
              "sdk/integrations",
              "sdk/opentelemetry",
              "sdk/cloud",
              "sdk/network"
            ]
          },
          {
            "group": "SDK tools",
            "pages": [
              "sdk/cli",
              "sdk/redteam",
              "sdk/contributing"
            ]
          },
          {
            "group": "Proxy Integration",
            "pages": [
              "proxy/overview",
              "proxy/openai-compatible",
              "proxy/setup",
              "proxy/how-it-works",
              "proxy/models"
            ]
          },
          {
            "group": "OpenTelemetry",
            "pages": [
              "otlp/overview"
            ]
          },
          {
            "group": "Detection",
            "pages": [
              "detection/overview",
              "detection/detectors",
              "detection/modes"
            ]
          },
          {
            "group": "Platform",
            "pages": [
              "platform/traces",
              "platform/analytics",
              "platform/alerts",
              "platform/policies",
              "platform/reports",
              "platform/team",
              "platform/api-keys"
            ]
          },
          {
            "group": "Architecture",
            "pages": [
              "architecture/overview"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/avaliar-ai",
          "icon": "github"
        },
        {
          "anchor": "Community",
          "href": "https://github.com/avaliar-ai/docs/discussions",
          "icon": "comments"
        }
      ]
    }
  },
  "redirects": [
    {
      "source": "/sdk/traceable",
      "destination": "/sdk/opentelemetry"
    },
    {
      "source": "/sdk/advanced-tracing",
      "destination": "/sdk/opentelemetry"
    },
    {
      "source": "/sdk/tool-call-tracing",
      "destination": "/sdk/checkpoints/tool-call"
    },
    {
      "source": "/sdk/base-llm",
      "destination": "/sdk/quickstart"
    },
    {
      "source": "/sdk/example-app",
      "destination": "/sdk/quickstart"
    },
    {
      "source": "/benchmarks/:slug*",
      "destination": "/sdk/redteam"
    },
    {
      "source": "/evals/:slug*",
      "destination": "/sdk/redteam"
    }
  ],
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@avaliar.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.avaliar.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/avaliar-ai",
      "x": "https://x.com/avaliar_ai",
      "linkedin": "https://linkedin.com/company/avaliar-ai"
    }
  }
}
